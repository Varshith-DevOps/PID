# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing secrets — keep OUT of version control, but back them up safely.
# The SAME keystore must be reused for every release so OTA updates can install
# over an existing install.
key.properties
*.jks
*.keystore
build_apk.log
