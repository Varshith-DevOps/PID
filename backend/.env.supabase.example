# ── Supabase (managed PostgreSQL) configuration ───────────────────────────────
# Copy the relevant values into backend/.env. NEVER commit the real .env.
# Supabase Dashboard → Project Settings → Database → Connection string.

# App runtime: use the TRANSACTION POOLER (PgBouncer, port 6543).
# pgbouncer=true tells Prisma not to use prepared statements.
# connection_limit is REQUIRED: Prisma's default pool (CPU*2+1) can exceed the
# Supabase pooler cap (15 on the free tier) and cause "EMAXCONNSESSION / max
# clients reached". Keep it comfortably under your plan's pool size.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=10"

# Prisma Migrate needs a DIRECT connection (port 5432) — it cannot run DDL
# through the transaction pooler. Used only by `prisma migrate`/`db push`.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# REQUIRED in production — the app refuses to boot without strong values.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"  # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"     # FIELD_ENCRYPTION_KEY
JWT_SECRET=""
FIELD_ENCRYPTION_KEY=""

JWT_EXPIRES_IN="7d"
# ACCESS_TOKEN_TTL="30m"        # optional hardening once the refresh flow is validated
PORT=5000
NODE_ENV=production
# ALLOWED_ORIGINS="https://your-frontend-domain"
