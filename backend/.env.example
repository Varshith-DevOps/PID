# Copy to .env and fill in real values. NEVER commit the real .env.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Database. SQLite for local dev; PostgreSQL for staging/production.
#   Local dev (default):  file:./dev.db
#   PostgreSQL:           postgresql://hrms:hrms@localhost:5432/hrms?schema=public
# See docs/07_PostgreSQL_Migration_Runbook.md for the cutover procedure.
DATABASE_URL="file:./dev.db"

# REQUIRED. JWT signing key. Must be >= 32 chars and unique per environment.
# The server refuses to boot in production with a missing/short/known-weak value.
JWT_SECRET=""

JWT_EXPIRES_IN="7d"
# Recommended hardening: short-lived access tokens + long-lived refresh tokens.
# Leave ACCESS_TOKEN_TTL unset to keep legacy behavior (= JWT_EXPIRES_IN). Once the
# frontend refresh flow is validated in staging, set e.g. ACCESS_TOKEN_TTL="30m".
# ACCESS_TOKEN_TTL="30m"
# REFRESH_TOKEN_TTL="30d"
PORT=5000

# REQUIRED IN PRODUCTION. AES-256 key for field-level encryption of PII at rest
# (PAN, Aadhaar, bank account number, MFA secret). Must decode to exactly 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset (dev/test), field encryption is disabled (data stored as-is).
# Rotating this key requires re-encrypting existing rows — keep it stable.
FIELD_ENCRYPTION_KEY=""

# Optional. Allowed CORS origins (comma-separated). Defaults to http://localhost:3000.
# ALLOWED_ORIGINS="https://app.example.com"

# Required only when mobile punch signing is enabled. No default fallback exists;
# if unset, signed mobile punches are rejected (fail closed). Generate like JWT_SECRET.
# MOBILE_APP_SECRET=""

# SMTP for payslip / notification email delivery.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""

# Optional: Redis enables (a) a shared rate-limit store across instances
# (npm i redis rate-limit-redis) and (b) the async job queue for slow work like
# bulk payslip email / report generation (npm i bullmq). Without it, rate limits
# are per-process and jobs run inline — fine for a single instance.
# REDIS_URL="redis://localhost:6379"

# Optional: error tracking (install: npm i @sentry/node).
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE=0
