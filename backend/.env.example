# Copy to .env and fill in real values. NEVER commit the real .env.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Database. SQLite for local dev; PostgreSQL for staging/production.
#   Local dev (default):  file:./dev.db
#   PostgreSQL:           postgresql://hrms:hrms@localhost:5432/hrms?schema=public
# See docs/07_PostgreSQL_Migration_Runbook.md for the cutover procedure.
DATABASE_URL="file:./dev.db"

# REQUIRED. JWT signing key. Must be >= 32 chars and unique per environment.
# The server refuses to boot in production with a missing/short/known-weak value.
JWT_SECRET=""

# Optional. bcrypt password-hashing cost factor. Defaults to 12 (OWASP minimum)
# and is clamped to a floor of 12, so this can only raise strength, never lower it.
BCRYPT_ROUNDS="12"

# Legacy fallback only. Prefer ACCESS_TOKEN_TTL below.
JWT_EXPIRES_IN="30m"
# Recommended hardening: short-lived access tokens + long-lived refresh tokens.
ACCESS_TOKEN_TTL="30m"
REFRESH_TOKEN_TTL="30d"
PORT=5000
APP_BASE_URL=http://localhost:3000

# REQUIRED IN PRODUCTION. AES-256 key for field-level encryption of PII at rest
# (PAN, Aadhaar, bank account number, MFA secret). Must decode to exactly 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset (dev/test), field encryption is disabled (data stored as-is).
# Rotating this key requires re-encrypting existing rows — keep it stable.
FIELD_ENCRYPTION_KEY=""

# Optional. Allowed CORS origins (comma-separated). Defaults to http://localhost:3000.
# Required in production so the API never falls back to localhost assumptions.
# ALLOWED_ORIGINS="https://app.example.com"

# ──── Multi-tenant subdomains ────────────────────────────────────────────────
# Base domain for tenant workspaces. Any <tenant>.<APP_BASE_DOMAIN> origin is
# CORS-allowed. Locally 'localhost' lets *.localhost resolve automatically.
# APP_BASE_DOMAIN="yourdomain.com"
#
# Set in production so the session cookie is shared across all tenant subdomains
# and the API host (leading dot). Leave unset locally (host-only cookie).
# Requires the frontend + API to share this registrable domain (e.g. api.yourdomain.com).
# COOKIE_DOMAIN=".yourdomain.com"
#
# Frontend (.env / Vercel): NEXT_PUBLIC_BASE_DOMAIN must match APP_BASE_DOMAIN
# so the browser resolves the tenant subdomain and sends x-tenant-subdomain.
# NEXT_PUBLIC_BASE_DOMAIN="yourdomain.com"

# Required only when mobile punch signing is enabled. No default fallback exists;
# if unset, signed mobile punches are rejected (fail closed). Generate like JWT_SECRET.
# MOBILE_APP_SECRET=""

# SMTP for payslip / notification email delivery.
# Gmail 587: SMTP_PORT=587 and SMTP_SECURE=false
# Gmail 465: SMTP_PORT=465 and SMTP_SECURE=true
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your-account@gmail.com"
# SMTP_PASS="your-16-character-google-app-password"
# SMTP_FROM_NAME="PID HCMS Recruitment"
# SMTP_FROM_EMAIL="your-account@gmail.com"
# APP_TIMEZONE="Asia/Kolkata"

# Offer letter generation and local development storage.
OFFER_STORAGE_MODE=local
OFFER_STORAGE_DIR=uploads/offers
OFFER_TOKEN_EXPIRY_DAYS=7
# PUPPETEER_EXECUTABLE_PATH=""

# Never enable mock billing in production. Real deployments must confirm payment
# only from a signed payment-provider webhook.
# ALLOW_MOCK_BILLING="false"
# If enabled, SALES can assign negotiated custom plans in production. Keep false
# unless an approval workflow and audit process are in place.
# ALLOW_SALES_CUSTOM_PLANS="false"

# Optional: Redis enables (a) a shared rate-limit store across instances
# (npm i redis rate-limit-redis) and (b) the async job queue for slow work like
# bulk payslip email / report generation (npm i bullmq). Without it, rate limits
# are per-process and jobs run inline — fine for a single instance.
# Required in production unless ALLOW_IN_MEMORY_LIMITERS="true" is explicitly set
# for a single-instance emergency deployment.
# REDIS_URL="redis://localhost:6379"
# ALLOW_IN_MEMORY_LIMITERS="false"

# Optional: error tracking (install: npm i @sentry/node).
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE=0

# ──── AWS / horizontal-scaling deployment ────────────────────────────────────
# PostgreSQL direct connection (non-pooled) for migrations / Prisma. With a
# pooler like Supabase/PgBouncer, DATABASE_URL is the pooled URL and DIRECT_URL
# is the direct one. With plain RDS, set both to the same connection string.
# DIRECT_URL="postgresql://hrms:...@your-rds-endpoint:5432/hrms"

# Number of proxies in front of the app (AWS ALB/CloudFront = 1). Enables real
# client IP for rate limiting and correct Secure-cookie behaviour. Default 1.
# TRUST_PROXY_HOPS="1"

# Background scheduler (billing dunning sweep) runs in-process. Set to false on
# every instance EXCEPT one when running more than one instance. Default: on.
# RUN_SCHEDULER="true"

# File uploads. Two production-safe options:
#  (a) S3 (recommended): set AWS_S3_BUCKET. Documents are stored in S3 and served
#      via short-lived presigned URLs. Credentials come from the instance IAM role.
#  (b) Shared disk: mount EFS and point UPLOAD_ROOT at it so all instances share
#      persistent upload storage (covers receipts/resumes/photos too).
# AWS_S3_BUCKET=""
# AWS_REGION="ap-south-1"
# AWS_S3_PREFIX="uploads"
# AWS_S3_SIGNED_TTL_SECONDS="300"
# UPLOAD_ROOT="/mnt/efs/hrms-uploads"

# ──── AI Recruitment Service ──────────────────────────────────────────────────
# URL where the AI recruitment microservice is reachable from the backend.
# Local dev: http://localhost:8001
# Docker (compose --profile ai): http://ai-recruitment-service:8001
# AI_RECRUITMENT_SERVICE_URL="http://localhost:8001"
#
# Shared secret that the backend sends as `Authorization: Bearer <token>` when
# calling the AI service. Must exactly match HRMS_SERVICE_TOKEN in
# ai-recruitment-service/.env. If either side is blank, every screening
# request fails with UNAUTHORIZED_SERVICE before any network call is made.
# Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AI_RECRUITMENT_SERVICE_TOKEN=""
#
# Optional timeout (ms) for AI screening HTTP calls. Defaults to 60 000 (1 min).
# Increase if the LLM provider is slow; decrease to fail faster in CI.
# AI_RECRUITMENT_TIMEOUT_MS=60000

