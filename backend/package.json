{
  "name": "hrms-backend",
  "version": "2.0.0",
  "description": "HRMS Backend API - Human Resource Management System",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:cluster": "node src/cluster.js",
    "dev": "node --watch src/index.js",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=prisma/schema.prisma",
    "schema:pg": "node scripts/make-postgres-schema.js",
    "db:pg:generate": "npm run schema:pg && npx prisma generate --schema=prisma/schema.postgres.prisma",
    "db:pg:push": "npm run schema:pg && npx prisma db push --schema=prisma/schema.postgres.prisma",
    "db:pg:migrate": "npm run schema:pg && npx prisma migrate deploy --schema=prisma/schema.postgres.prisma",
    "vercel-build": "npm run db:pg:generate",
    "seed": "node prisma/seed.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.16.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "supertest": "^7.0.2"
  }
}
