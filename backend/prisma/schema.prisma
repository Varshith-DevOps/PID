generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  name               String
  role               String              @default("EMPLOYEE")
  isActive           Boolean             @default(true)
  mustChangePassword Boolean             @default(false)
  tokenVersion       Int                 @default(0)
  companyId          String?
  company            Company?            @relation(fields: [companyId], references: [id])
  lastLoginAt        DateTime?
  mfaEnabled         Boolean             @default(false)
  mfaSecret          String?
  mfaRecoveryCodes   String?
  mfaLastVerifiedAt  DateTime?
  permissions        Permission[]        @relation("UserPermissions")
  employee           Employee?           @relation("UserEmployee")
  supportAssignments SupportAssignment[] @relation("SupportStaffAssignments")
  authenticators     Authenticator[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("users")
}

model Authenticator {
  id           String   @id @default(uuid())
  credentialId String   @unique
  publicKey    String
  counter      Int
  transports   String   // transport list
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("authenticators")
}

/// Platform support/maintenance staff (role SUPPORT, no home company) granted
/// READ-ONLY visibility into a specific customer tenant. The auth middleware
/// scopes a support user's reads to an assigned company when they "view" it.
model SupportAssignment {
  id           String   @id @default(uuid())
  staffUserId  String
  staffUser    User     @relation("SupportStaffAssignments", fields: [staffUserId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedById String?
  status       String   @default("ACTIVE") // ACTIVE | REVOKED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([staffUserId, companyId])
  @@index([staffUserId])
  @@map("support_assignments")
}

/// A tenant-defined access-control module (permission scope) that exists ONLY for
/// that organization. It appears in the tenant's access matrix and can be granted
/// to roles/users; it is deny-by-default until granted. Other tenants never see it.
model CustomModule {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key         String // uppercase identifier, e.g. INVENTORY
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
  @@map("custom_modules")
}

model Permission {
  id        String  @id @default(uuid())
  module    String
  action    String
  isGranted Boolean @default(false)
  user      User    @relation("UserPermissions", fields: [userId], references: [id])
  userId    String

  @@unique([userId, module, action])
  @@map("permissions")
}

model Department {
  id          String       @id @default(uuid())
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean      @default(true)
  employees   Employee[]
  kpis        KpiDefinition[]
  jobOpenings JobOpening[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([companyId, name])
  @@map("departments")
}

model Employee {
  id             String       @id @default(uuid())
  employeeId     String
  firstName      String
  lastName       String
  email          String       @unique
  phone          String?
  dateOfBirth    DateTime?
  gender         String?
  photoUrl       String?
  accountStage   String       @default("EMPLOYEE")
  address        String?
  nationality    String?
  location       String?
  company        Company?     @relation(fields: [companyId], references: [id])
  companyId      String?
  legalEntity    LegalEntity? @relation(fields: [legalEntityId], references: [id])
  legalEntityId  String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?
  workLocation   Location?    @relation(fields: [workLocationId], references: [id])
  workLocationId String?

  // Personal details
  bloodGroup    String?
  maritalStatus String?
  personalEmail String?
  panNumber     String?
  aadharNumber  String?
  esicNumber    String?

  // Emergency contact
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  // DPDP: set when the subject's PII is erased/anonymized (statutory records kept).
  anonymizedAt             DateTime?

  // Professional
  jobTitle       String
  department     Department @relation(fields: [departmentId], references: [id])
  departmentId   String
  employmentType String     @default("FULL_TIME")
  joinDate       DateTime   @default(now())
  salary         Float
  annualCTC      Float?
  bonusPercent   Float?

  // Linked user account
  user   User?   @relation("UserEmployee", fields: [userId], references: [id])
  userId String? @unique

  manager      Employee?  @relation("ManagerRelation", fields: [managerId], references: [id])
  managerId    String?
  subordinates Employee[] @relation("ManagerRelation")

  documents        Document[]
  attendances      Attendance[]
  leaves           Leave[]
  leaveQuotas      LeaveQuota[]
  salaryStructure  SalaryStructure?
  payrollRecords   PayrollRecord[]
  managedProjects  Project[]         @relation("ProjectManager")
  projectResources ProjectResource[] @relation("EmployeeResources")
  tasks            Task[]
  timesheets       Timesheet[]
  overtimes        Overtime[]

  // New relations
  addresses               EmployeeAddress[]
  education               Education[]
  experience              ProfessionalExperience[]
  salaryRevisions         SalaryRevision[]
  bankDetails             BankDetails?
  pfDetails               PFDetails?
  exitDetails             ExitDetails?
  dependents              Dependent[]
  changeHistory           ChangeHistory[]
  kras                    KRA[]
  appraisals              PerformanceAppraisal[]
  feedbacksReceived       Feedback360[]              @relation("RecipientRelation")
  feedbacksGiven          Feedback360[]              @relation("ReviewerRelation")
  expenseClaims           ExpenseClaim[]
  travelAdvances          TravelAdvance[]
  shiftAssignments        ShiftAssignment[]
  checklistTasks          EmployeeChecklistTask[]
  regularizations         AttendanceRegularization[]
  previousEmployerIncomes PreviousEmployerIncome[]
  taxDeclarations         EmployeeTaxDeclaration[]
  tdsLedgerEntries        TDSLedger[]
  assetAssignments        Asset[]
  learningEnrollments     LearningEnrollment[]
  learningBookmarks       LearningBookmark[]
  learningCertificates    Certificate[]
  learningNotifications   LearningNotification[]
  learningLessonProgress  LearningLessonProgress[]
  learningNotes           LearningNote[]
  learningFavorites       LearningFavorite[]
  employeeLearningSkills  EmployeeLearningSkill[]
  learningFeedback        LearningFeedback[]
  learningAssessmentSubmissions LearningAssessmentSubmission[]
  kpiAssignments           EmployeeKpiAssignment[]
  helpdeskTickets         HelpdeskTicket[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  kudosBalance            Int                      @default(0)
  monthlyKudosAllowance   Int                      @default(100)
  lastKudosAllowanceReset DateTime?
  sentKudos               Kudos[]                  @relation("SentKudos")
  receivedKudos           Kudos[]                  @relation("ReceivedKudos")
  perkPurchases           PerkPurchase[]
  objectives              Objective[]
  reviewsWritten          PerformanceReview9Box[]    @relation("ReviewsWritten")
  performanceReviews      PerformanceReview9Box[]    @relation("EmployeeReviews")
  assetRequests           AssetRequest[]

  isActive                    Boolean   @default(true)
  deactivatedAt               DateTime?
  deactivatedBy               String?
  deactivationReason          String?
  deactivationRemarks         String?
  deactivationEffectiveDate   DateTime?
  reactivatedAt               DateTime?
  reactivatedBy               String?
  reactivationRemarks         String?
  timezone                    String    @default("Asia/Kolkata")
  biometricId                 String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@unique([companyId, employeeId])
  @@index([companyId, isActive])
  @@index([departmentId, isActive])
  @@index([managerId, isActive])
  @@index([dateOfBirth])
  @@map("employees")
}

model EmployeeAddress {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  type       String   @default("CURRENT")
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("employee_addresses")
}

model Education {
  id             String   @id @default(uuid())
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     String
  degree         String
  specialization String?
  institution    String
  university     String?
  yearOfPassing  Int
  percentage     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("education")
}

model ProfessionalExperience {
  id          String    @id @default(uuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  company     String
  designation String
  fromDate    DateTime
  toDate      DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("professional_experience")
}

model SalaryRevision {
  id             String   @id @default(uuid())
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     String
  effectiveDate  DateTime
  previousSalary Float
  revisedSalary  Float
  reason         String?
  revisedBy      String?
  createdAt      DateTime @default(now())

  @@map("salary_revisions")
}

model ChangeHistory {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  changedBy  String
  entity     String
  field      String
  oldValue   String?
  newValue   String?
  reason     String
  createdAt  DateTime @default(now())

  @@map("change_history")
}

model Document {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  fileName    String
  filePath    String
  fileSize    Int?
  mimeType    String?
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@map("documents")
}

model BankDetails {
  id            String   @id @default(uuid())
  employee      Employee @relation(fields: [employeeId], references: [id])
  employeeId    String   @unique
  bankName      String
  accountNumber String
  ifscCode      String
  branchName    String?
  accountType   String   @default("SAVINGS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_details")
}

model PFDetails {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  employeeId    String    @unique
  pfNumber      String?
  uanNumber     String?
  epsNumber     String?
  pfJoinDate    DateTime?
  voluntaryPF   Boolean   @default(false)
  vpfPercentage Float?
  esiNumber     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("pf_details")
}

model ExitDetails {
  id               String    @id @default(uuid())
  employee         Employee  @relation(fields: [employeeId], references: [id])
  employeeId       String    @unique
  exitType         String?
  resignationDate  DateTime?
  lastWorkingDate  DateTime?
  noticePeriodDays Int?
  exitReason       String?
  exitInterview    Boolean   @default(false)
  rehireEligible   Boolean   @default(true)
  fnfStatus        String    @default("PENDING")
  fnfAmount        Float?
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("exit_details")
}

model Dependent {
  id             String    @id @default(uuid())
  employee       Employee  @relation(fields: [employeeId], references: [id])
  employeeId     String
  name           String
  relationship   String
  dateOfBirth    DateTime?
  gender         String?
  isNominee      Boolean   @default(false)
  nomineePercent Float?
  isActive       Boolean   @default(true)
  inactiveRemark String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("dependents")
}

model Attendance {
  id                   String    @id @default(uuid())
  employee             Employee  @relation(fields: [employeeId], references: [id])
  employeeId           String
  date                 DateTime  @default(now())
  checkIn              DateTime?
  checkOut             DateTime?
  status               String    @default("PRESENT")
  lateMinutes          Int?
  workHours            Float?
  notes                String?
  markedBy             String?
  originalCheckIn      DateTime?
  originalCheckOut     DateTime?
  regularizedBy        String?
  regularizedAt        DateTime?
  regularizationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
  @@map("attendances")
}

model AttendanceSettings {
  id               String  @id @default(uuid())
  companyId        String?
  checkInStartTime String  @default("09:00")
  checkInEndTime   String  @default("09:30")
  checkOutTime     String  @default("18:00")
  lateThreshold    Int     @default(30)
  halfDayThreshold Int     @default(4)
  isActive         Boolean @default(true)

  @@index([companyId])
  @@map("attendance_settings")
}

model Leave {
  id           String    @id @default(uuid())
  employee     Employee  @relation(fields: [employeeId], references: [id])
  employeeId   String
  leaveType    String
  startDate    DateTime
  endDate      DateTime
  days         Float
  reason       String?
  status       String    @default("PENDING")
  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([status, startDate, endDate])
  @@map("leaves")
}

model LeaveQuota {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  year       Int
  leaveType  String
  quota      Float
  used       Float    @default(0)

  @@unique([employeeId, year, leaveType])
  @@index([employeeId, year])
  @@map("leave_quotas")
}

model SalaryStructure {
  id               String   @id @default(uuid())
  employee         Employee @relation(fields: [employeeId], references: [id])
  employeeId       String
  basicSalary      Float
  hra              Float    @default(0)
  da               Float    @default(0)
  conveyance       Float    @default(0)
  medical          Float    @default(0)
  specialAllowance Float    @default(0)
  otherAllowance   Float    @default(0)

  pfEnabled              Boolean @default(true)
  pfRate                 Float   @default(0.12)
  tdsEnabled             Boolean @default(true)
  esiEnabled             Boolean @default(true)
  professionalTaxEnabled Boolean @default(true)
  lwfEnabled             Boolean @default(true)
  npsEnabled             Boolean @default(false)
  npsRate                Float   @default(0.10)
  insurance              Float   @default(0)
  otherDeduction         Float   @default(0)

  usePercentSettings Boolean @default(true)

  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId])
  @@map("salary_structures")
}

model PayrollSettings {
  id                  String  @id @default(uuid())
  companyId           String?
  pfRate              Float   @default(0.12)
  maxPf               Float   @default(2160)
  gratuityRate        Float   @default(0.0481)
  tdsEnabled          Boolean @default(true)
  epfEnabled          Boolean @default(true)
  epsEnabled          Boolean @default(true)
  otMultiplier        Float   @default(1.5)
  standardHours       Float   @default(176)
  ptRate              Float   @default(200.0)
  esiRateEmployee     Float   @default(0.0075)
  esiRateEmployer     Float   @default(0.0325)
  esiGrossCeiling     Float   @default(21000.0)
  pfWageCeiling       Float   @default(15000.0)
  restrictPfToCeiling Boolean @default(true)
  isActive            Boolean @default(true)

  hraPercent              Float @default(40.0)
  daPercent               Float @default(20.0)
  conveyancePercent       Float @default(10.0)
  medicalPercent          Float @default(5.0)
  specialAllowancePercent Float @default(15.0)
  insurancePercent        Float @default(5.0)

  @@index([companyId])
  @@map("payroll_settings")
}

model PayrollRecord {
  id           String     @id @default(uuid())
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  payrollRunId String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  employeeId   String

  basicSalary      Float
  hra              Float
  da               Float
  conveyance       Float
  medical          Float
  specialAllowance Float
  otherAllowance   Float

  grossEarnings   Float
  pf              Float
  tax             Float
  esi             Float @default(0)
  professionalTax Float @default(0)
  insurance       Float
  otherDeductions Float
  totalDeductions Float

  netSalary Float

  workDays             Int
  daysWorked           Int
  leaves               Float
  deductions           Float
  lopDays              Float   @default(0)
  lopDeduction         Float   @default(0)
  overtimeHours        Float   @default(0)
  overtimePay          Float   @default(0)
  arrears              Float   @default(0)
  incentives           Float   @default(0)
  vpfAmount            Float   @default(0)
  lwfEmployee          Float   @default(0)
  lwfEmployer          Float   @default(0)
  npsEmployee          Float   @default(0)
  npsEmployer          Float   @default(0)
  bonusAmount          Float   @default(0)
  tdsRegime            String  @default("NEW")
  incomeTaxDeclaration Boolean @default(false)
  investmentProofs     Boolean @default(false)
  complianceNotes      String?

  status    String   @default("PROCESSED")
  createdAt DateTime @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_records")
}

model PayrollRun {
  id             String            @id @default(uuid())
  month          Int
  year           Int
  legalEntity    LegalEntity?      @relation(fields: [legalEntityId], references: [id])
  legalEntityId  String?
  companyId      String?
  status         String            @default("DRAFT")
  totalAmount    Float?
  totalPf        Float?            @default(0)
  totalTds       Float?            @default(0)
  totalGratuity  Float?            @default(0)
  employeeCount  Int?
  processedBy    String?
  processedAt    DateTime?
  reviewedBy     String?
  reviewedAt     DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  reversedBy     String?
  reversalReason String?
  reversedAt     DateTime?
  records        PayrollRecord[]
  approvals      PayrollApproval[]
  createdAt      DateTime          @default(now())

  @@unique([companyId, month, year])
  @@index([companyId])
  @@index([createdAt])
  @@map("payroll_runs")
}

model Project {
  id          String    @id @default(uuid())
  companyId   String?
  name        String
  description String?
  startDate   DateTime?
  deadline    DateTime?
  budget      Float     @default(0)
  currency    String    @default("INR")
  billingType String    @default("TIME_AND_MATERIAL") // or FIXED_BID / NON_BILLABLE
  status      String    @default("PLANNING")

  manager   Employee          @relation("ProjectManager", fields: [managerId], references: [id])
  managerId String
  resources ProjectResource[]

  tasks    Task[]
  sprints  Sprint[]
  expenses ProjectExpense[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("projects")
}

model ProjectResource {
  id            String   @id @default(uuid())
  project       Project  @relation(fields: [projectId], references: [id])
  projectId     String
  employee      Employee @relation("EmployeeResources", fields: [employeeId], references: [id])
  employeeId    String
  joinedAt      DateTime @default(now())
  costRate      Float    @default(0) // internal cost per hour (company cost)
  billRate      Float    @default(0) // client bill rate per hour (revenue)
  allocationPct Float? // optional % allocation to this project

  @@unique([projectId, employeeId])
  @@index([employeeId])
  @@map("project_resources")
}

model ProjectExpense {
  id          String   @id @default(uuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  description String
  amount      Float
  date        DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())

  @@map("project_expenses")
}

model Task {
  id          String   @id @default(uuid())
  companyId   String?
  title       String
  description String?
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  assignee    Employee @relation(fields: [assigneeId], references: [id])
  assigneeId  String

  estimatedHours Float?
  actualHours    Float     @default(0)
  storyPoints    Int?
  boardRank      Float     @default(0) // ordering within a board column
  billable       Boolean   @default(true)
  sprint         Sprint?   @relation(fields: [sprintId], references: [id])
  sprintId       String?
  deadline       DateTime?
  priority       String    @default("MEDIUM")
  status         String    @default("TODO")

  completedAt DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timesheets Timesheet[]

  @@index([companyId])
  @@index([assigneeId, status])
  @@index([deadline])
  @@map("tasks")
}

model Sprint {
  id        String   @id @default(uuid())
  companyId String?
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("PLANNING") // PLANNING / ACTIVE / COMPLETED
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("sprints")
}

model Timesheet {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  task        Task?    @relation(fields: [taskId], references: [id])
  taskId      String?
  date        DateTime
  hoursWorked Float
  description String?
  createdAt   DateTime @default(now())

  @@unique([employeeId, taskId, date])
  @@index([employeeId, date])
  @@index([taskId])
  @@map("timesheets")
}

model Overtime {
  id           String   @id @default(uuid())
  employee     Employee @relation(fields: [employeeId], references: [id])
  employeeId   String
  date         DateTime
  regularHours Float    @default(8)
  otHours      Float
  reason       String?
  status       String   @default("PENDING")
  exceedsLimit Boolean  @default(false)

  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("overtime_requests")
}

model JobOpening {
  id             String         @id @default(uuid())
  companyId      String?
  title          String
  department     Department     @relation(fields: [departmentId], references: [id])
  departmentId   String
  description    String
  requirements   String
  location       String
  employmentType String         @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  salaryRange    String?
  status         String         @default("OPEN") // DRAFT, OPEN, CLOSED
  applicants     JobApplicant[]
  aiAssessments  AiCandidateAssessment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId])
  @@map("job_openings")
}

model JobApplicant {
  id           String      @id @default(uuid())
  jobOpening   JobOpening  @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  jobOpeningId String
  fullName     String
  email        String
  phone        String
  resumeUrl    String?
  coverLetter  String?
  experience   String?
  skills       String?
  currentCtc   String?
  expectedCtc  String?
  noticePeriod String?
  source       String      @default("MANUAL") // MANUAL, SOCIAL_MEDIA, CAREER_PORTAL
  stage        String      @default("APPLIED") // APPLIED, SCREENING, INTERVIEW, OFFER, REJECTED, HIRED
  rating       Int? // 1 to 5
  notes        String?
  interviews   Interview[]
  reviews      CandidateReview[]
  jobOffer     JobOffer?
  aiAssessments AiCandidateAssessment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("job_applicants")
}

model AiCandidateAssessment {
  id                     String       @id @default(uuid())
  tenantId               String
  companyId              String?
  organizationId         String
  job                    JobOpening   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId                  String
  application            JobApplicant @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId          String
  candidateId            String
  workflowId             String       @unique
