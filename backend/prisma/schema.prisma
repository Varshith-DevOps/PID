  subdomain      String? @unique
  email          String?
  phone          String?
  address        String?
  industry       String?
  companySize    String?
  status         String  @default("ACTIVE")
  subscriptionId String?

  // Customization fields
  logoUrl    String?
  customInfo String?

  // Payslip format / template selection.
  // The company Admin may choose and customize the format ONCE; saving locks it.
  // After it is locked, only the PID hcms SUPER_ADMIN team can change it.
  payslipTemplateId      String? // one of the catalog ids, e.g. "classic", "modern"
  payslipTemplateConfig  String? // JSON: accent colour, optional toggles, header note, signatory
  payslipTemplateLocked  Boolean   @default(false)
  payslipTemplateSetById String?
  payslipTemplateSetAt   DateTime?

  // KYC Verification fields
  cin                   String?
  gstin                 String?
  directorName          String?
  directorPan           String?
  directorDin           String?
  signingAuthorityName  String?
  signingAuthorityEmail String?
  signingAuthorityPhone String?
  contactPersonName     String?
  contactPersonEmail    String?
  contactPersonPhone    String?
  kycStatus             String    @default("PENDING") // PENDING, APPROVED, REJECTED
  kycRemarks            String?
  demoCallScheduledAt   DateTime?

  // Free Trial Management
  hasUsedFreeTrial   Boolean   @default(false)
  freeTrialExpiresAt DateTime?

  // Billing / dunning lifecycle (payment-driven, distinct from manual `status`).
  billingStatus String    @default("CURRENT") // CURRENT | PAST_DUE | SUSPENDED_NONPAYMENT
  graceEndsAt   DateTime?

  users              User[]
  departments        Department[]
  legalEntities      LegalEntity[]
  branches           Branch[]
  locations          Location[]
  employees          Employee[]
  policies           PolicyDefinition[]
  workflows          WorkflowDefinition[]
  integrations       IntegrationConnection[]
  compliance         ComplianceObligation[]
  subscriptions      Subscription[]
  payments           PaymentTransaction[]
  supportAssignments SupportAssignment[]
  notifications      Notification[]
  whitelistedWifis   WhiteListedWiFi[]
  biometricRawLogs   BiometricRawLog[]
  notificationTemplates NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  notificationSettings NotificationSetting?
  kudos                  Kudos[]
  perkStoreItems         PerkStoreItem[]
  perkPurchases          PerkPurchase[]
  pulseSurveys           PulseSurvey[]
  pulseResponses         PulseResponse[]
  objectives             Objective[]
  performanceReviews     PerformanceReview9Box[]
  assetRequests          AssetRequest[]
  customModules      CustomModule[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@map("companies")
}

