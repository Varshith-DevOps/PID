generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String
  name         String
  role         String       @default("EMPLOYEE")
  isActive     Boolean      @default(true)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  lastLoginAt  DateTime?
  mfaEnabled   Boolean      @default(false)
  mfaSecret    String?
  mfaRecoveryCodes String?
  mfaLastVerifiedAt DateTime?
  permissions  Permission[] @relation("UserPermissions")
  employee     Employee?    @relation("UserEmployee")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("users")
}

model Permission {
  id        String   @id @default(uuid())
  module    String
  action    String
  isGranted Boolean  @default(false)
  user      User     @relation("UserPermissions", fields: [userId], references: [id])
  userId    String

  @@unique([userId, module, action])
  @@map("permissions")
}

model Department {
  id          String     @id @default(uuid())
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  jobOpenings JobOpening[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, name])
  @@map("departments")
}

model Employee {
  id              String        @id @default(uuid())
  employeeId      String
  firstName       String
  lastName        String
  email           String        @unique
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  photoUrl        String?
  accountStage    String    @default("EMPLOYEE")
  address         String?
  nationality     String?
  location        String?
  company         Company?      @relation(fields: [companyId], references: [id])
  companyId       String?
  legalEntity     LegalEntity?  @relation(fields: [legalEntityId], references: [id])
  legalEntityId   String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  branchId        String?
  workLocation    Location?     @relation(fields: [workLocationId], references: [id])
  workLocationId  String?

  // Personal details
  bloodGroup      String?
  maritalStatus   String?
  personalEmail   String?
  panNumber       String?
  aadharNumber    String?
  esicNumber      String?

  // Emergency contact
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Professional
  jobTitle        String
  department      Department    @relation(fields: [departmentId], references: [id])
  departmentId    String
  employmentType  String        @default("FULL_TIME")
  joinDate        DateTime      @default(now())
  salary          Float
  annualCTC       Float?
  bonusPercent    Float?

  // Linked user account
  user            User?         @relation("UserEmployee", fields: [userId], references: [id])
  userId          String?       @unique

  manager         Employee?     @relation("ManagerRelation", fields: [managerId], references: [id])
  managerId       String?
  subordinates    Employee[]    @relation("ManagerRelation")

  documents       Document[]
  attendances     Attendance[]
  leaves          Leave[]
  leaveQuotas     LeaveQuota[]
  salaryStructure SalaryStructure?
  payrollRecords  PayrollRecord[]
  managedProjects Project[]      @relation("ProjectManager")
  projectResources ProjectResource[] @relation("EmployeeResources")
  tasks           Task[]
  timesheets      Timesheet[]
  overtimes       Overtime[]

  // New relations
  addresses       EmployeeAddress[]
  education       Education[]
  experience      ProfessionalExperience[]
  salaryRevisions SalaryRevision[]
  bankDetails     BankDetails?
  pfDetails       PFDetails?
  exitDetails     ExitDetails?
  dependents      Dependent[]
  changeHistory   ChangeHistory[]
  kras             KRA[]
  appraisals       PerformanceAppraisal[]
  feedbacksReceived Feedback360[]          @relation("RecipientRelation")
  feedbacksGiven    Feedback360[]          @relation("ReviewerRelation")
  expenseClaims    ExpenseClaim[]
  travelAdvances   TravelAdvance[]
  shiftAssignments ShiftAssignment[]
  checklistTasks   EmployeeChecklistTask[]
  regularizations  AttendanceRegularization[]
  previousEmployerIncomes PreviousEmployerIncome[]
  taxDeclarations       EmployeeTaxDeclaration[]
  tdsLedgerEntries      TDSLedger[]
  assetAssignments      Asset[]
  learningEnrollments   LearningEnrollment[]
  helpdeskTickets       HelpdeskTicket[]
  notifications         Notification[]

  isActive        Boolean        @default(true)
  timezone        String         @default("Asia/Kolkata")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([companyId, employeeId])
  @@map("employees")
}

model EmployeeAddress {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  type        String   @default("CURRENT")
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  country     String   @default("India")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("employee_addresses")
}

model Education {
  id              String   @id @default(uuid())
  employee        Employee @relation(fields: [employeeId], references: [id])
  employeeId      String
  degree          String
  specialization  String?
  institution     String
  university      String?
  yearOfPassing   Int
  percentage      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("education")
}

model ProfessionalExperience {
  id          String    @id @default(uuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  company     String
  designation String
  fromDate    DateTime
  toDate      DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("professional_experience")
}

model SalaryRevision {
  id             String   @id @default(uuid())
  employee       Employee @relation(fields: [employeeId], references: [id])
  employeeId     String
  effectiveDate  DateTime
  previousSalary Float
  revisedSalary  Float
  reason         String?
  revisedBy      String?
  createdAt      DateTime @default(now())

  @@map("salary_revisions")
}

model ChangeHistory {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  changedBy   String
  entity      String
  field       String
  oldValue    String?
  newValue    String?
  reason      String
  createdAt   DateTime @default(now())

  @@map("change_history")
}

model Document {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  fileName    String
  filePath    String
  fileSize    Int?
  mimeType    String?
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@map("documents")
}

model BankDetails {
  id            String   @id @default(uuid())
  employee      Employee @relation(fields: [employeeId], references: [id])
  employeeId    String   @unique
  bankName      String
  accountNumber String
  ifscCode      String
  branchName    String?
  accountType   String   @default("SAVINGS")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_details")
}

model PFDetails {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  employeeId    String    @unique
  pfNumber      String?
  uanNumber     String?
  epsNumber     String?
  pfJoinDate    DateTime?
  voluntaryPF   Boolean   @default(false)
  vpfPercentage Float?
  esiNumber     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("pf_details")
}

model ExitDetails {
  id                String    @id @default(uuid())
  employee          Employee  @relation(fields: [employeeId], references: [id])
  employeeId        String    @unique
  exitType          String?
  resignationDate   DateTime?
  lastWorkingDate   DateTime?
  noticePeriodDays  Int?
  exitReason        String?
  exitInterview     Boolean   @default(false)
  rehireEligible    Boolean   @default(true)
  fnfStatus         String    @default("PENDING")
  fnfAmount         Float?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("exit_details")
}

model Dependent {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  employeeId    String
  name          String
  relationship  String
  dateOfBirth   DateTime?
  gender        String?
  isNominee     Boolean   @default(false)
  nomineePercent Float?
  isActive      Boolean   @default(true)
  inactiveRemark String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("dependents")
}

model Attendance {
  id          String    @id @default(uuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  date        DateTime  @default(now())
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT")
  lateMinutes Int?
  workHours   Float?
  notes       String?
  markedBy    String?
  originalCheckIn      DateTime?
  originalCheckOut     DateTime?
  regularizedBy        String?
  regularizedAt        DateTime?
  regularizationReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, date])
  @@map("attendances")
}

model AttendanceSettings {
  id               String   @id @default(uuid())
  checkInStartTime String   @default("09:00")
  checkInEndTime   String   @default("09:30")
  checkOutTime     String   @default("18:00")
  lateThreshold    Int      @default(30)
  halfDayThreshold Int      @default(4)
  isActive         Boolean  @default(true)

  @@map("attendance_settings")
}

model Leave {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  employeeId    String
  leaveType     String
  startDate     DateTime
  endDate       DateTime
  days          Float
  reason        String?
  status        String    @default("PENDING")
  approvedBy    String?
  approvedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("leaves")
}

model LeaveQuota {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  year        Int
  leaveType   String
  quota       Float
  used        Float    @default(0)

  @@unique([employeeId, year, leaveType])
  @@map("leave_quotas")
}

model SalaryStructure {
  id              String    @id @default(uuid())
  employee        Employee  @relation(fields: [employeeId], references: [id])
  employeeId      String
  basicSalary     Float
  hra             Float     @default(0)
  da              Float     @default(0)
  conveyance      Float     @default(0)
  medical         Float     @default(0)
  specialAllowance Float    @default(0)
  otherAllowance  Float     @default(0)
  
  pfEnabled       Boolean   @default(true)
  pfRate          Float     @default(0.12)
  tdsEnabled      Boolean   @default(true)
  esiEnabled      Boolean   @default(true)
  professionalTaxEnabled Boolean @default(true)
  lwfEnabled      Boolean   @default(true)
  npsEnabled      Boolean   @default(false)
  npsRate         Float     @default(0.10)
  insurance       Float     @default(0)
  otherDeduction  Float     @default(0)
  
  usePercentSettings Boolean  @default(true)
  
  effectiveFrom   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId])
  @@map("salary_structures")
}

model PayrollSettings {
  id              String   @id @default(uuid())
  pfRate          Float    @default(0.12)
  maxPf           Float    @default(2160)
  gratuityRate    Float    @default(0.0481)
  tdsEnabled      Boolean  @default(true)
  epfEnabled      Boolean  @default(true)
  epsEnabled      Boolean  @default(true)
  otMultiplier    Float    @default(1.5)
  standardHours   Float    @default(176)
  ptRate          Float    @default(200.0)
  esiRateEmployee Float    @default(0.0075)
  esiRateEmployer Float    @default(0.0325)
  esiGrossCeiling Float    @default(21000.0)
  pfWageCeiling   Float    @default(15000.0)
  restrictPfToCeiling Boolean @default(true)
  isActive        Boolean  @default(true)

  hraPercent              Float    @default(40.0)
  daPercent               Float    @default(20.0)
  conveyancePercent       Float    @default(10.0)
  medicalPercent          Float    @default(5.0)
  specialAllowancePercent Float    @default(15.0)
  insurancePercent        Float    @default(5.0)

  @@map("payroll_settings")
}

model PayrollRecord {
  id              String      @id @default(uuid())
  payrollRun       PayrollRun  @relation(fields: [payrollRunId], references: [id])
  payrollRunId    String
  employee        Employee    @relation(fields: [employeeId], references: [id])
  employeeId      String
  
  basicSalary     Float
  hra             Float
  da              Float
  conveyance      Float
  medical         Float
  specialAllowance Float
  otherAllowance  Float
  
  grossEarnings   Float
  pf              Float
  tax             Float
  esi             Float       @default(0)
  professionalTax Float       @default(0)
  insurance       Float
  otherDeductions Float
  totalDeductions Float
  
  netSalary       Float
  
  workDays        Int
  daysWorked      Int
  leaves          Float
  deductions      Float
  lopDays         Float       @default(0)
  lopDeduction    Float       @default(0)
  overtimeHours   Float       @default(0)
  overtimePay     Float       @default(0)
  arrears         Float       @default(0)
  incentives      Float       @default(0)
  vpfAmount       Float       @default(0)
  lwfEmployee     Float       @default(0)
  lwfEmployer     Float       @default(0)
  npsEmployee     Float       @default(0)
  npsEmployer     Float       @default(0)
  bonusAmount     Float       @default(0)
  tdsRegime       String      @default("NEW")
  incomeTaxDeclaration Boolean @default(false)
  investmentProofs Boolean    @default(false)
  complianceNotes String?
  
  status          String      @default("PROCESSED")
  createdAt       DateTime    @default(now())

  @@unique([payrollRunId, employeeId])
  @@map("payroll_records")
}

model PayrollRun {
  id              String         @id @default(uuid())
  month           Int
  year            Int
  legalEntity     LegalEntity?   @relation(fields: [legalEntityId], references: [id])
  legalEntityId   String?
  status          String         @default("DRAFT")
  totalAmount     Float?
  totalPf         Float?         @default(0)
  totalTds        Float?         @default(0)
  totalGratuity   Float?         @default(0)
  employeeCount   Int?
  processedBy     String?
  processedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  reversedBy      String?
  reversalReason  String?
  reversedAt      DateTime?
  records         PayrollRecord[]
  approvals       PayrollApproval[]
  createdAt       DateTime        @default(now())

  @@unique([month, year])
  @@map("payroll_runs")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  deadline    DateTime?
  budget      Float         @default(0)
  status      String        @default("PLANNING")
  
  manager     Employee      @relation("ProjectManager", fields: [managerId], references: [id])
  managerId   String
  resources   ProjectResource[]
  
  tasks       Task[]
  expenses    ProjectExpense[]
  
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("projects")
}

model ProjectResource {
  id          String   @id @default(uuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  employee    Employee @relation("EmployeeResources", fields: [employeeId], references: [id])
  employeeId  String
  joinedAt    DateTime @default(now())

  @@unique([projectId, employeeId])
  @@map("project_resources")
}

model ProjectExpense {
  id          String   @id @default(uuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  description String
  amount      Float
  date        DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())

  @@map("project_expenses")
}

model Task {
  id             String      @id @default(uuid())
  title          String
  description    String?
  project        Project?    @relation(fields: [projectId], references: [id])
  projectId      String?
  assignee       Employee    @relation(fields: [assigneeId], references: [id])
  assigneeId    String
  
  estimatedHours Float?
  actualHours    Float       @default(0)
  deadline       DateTime?
  priority       String      @default("MEDIUM")
  status         String      @default("TODO")
  
  completedAt    DateTime?
  createdBy      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  timesheets     Timesheet[]

  @@map("tasks")
}

model Timesheet {
  id          String   @id @default(uuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  task        Task?    @relation(fields: [taskId], references: [id])
  taskId      String?
  date        DateTime
  hoursWorked Float
  description String?
  createdAt   DateTime @default(now())

  @@unique([employeeId, taskId, date])
  @@map("timesheets")
}

model Overtime {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  employeeId    String
  date          DateTime
  regularHours  Float     @default(8)
  otHours       Float
  reason        String?
  status        String    @default("PENDING")
  exceedsLimit  Boolean   @default(false)
  
  approvedBy    String?
  approvedAt    DateTime?
  rejectReason  String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("overtime_requests")
}

model JobOpening {
  id             String         @id @default(uuid())
  title          String
  department     Department     @relation(fields: [departmentId], references: [id])
  departmentId   String
  description    String
  requirements   String
  location       String
  employmentType String         @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  salaryRange    String?
  status         String         @default("OPEN") // DRAFT, OPEN, CLOSED
  applicants     JobApplicant[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("job_openings")
}

model JobApplicant {
  id           String      @id @default(uuid())
  jobOpening   JobOpening  @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  jobOpeningId String
  fullName     String
  email        String
  phone        String
  resumeUrl    String?
  coverLetter  String?
  stage        String      @default("APPLIED") // APPLIED, SCREENING, INTERVIEW, OFFER, REJECTED, HIRED
  rating       Int?        // 1 to 5
  notes        String?
  interviews   Interview[]
  jobOffer     JobOffer?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("job_applicants")
}

model Interview {
  id              String       @id @default(uuid())
  applicant       JobApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId     String
  interviewerName String
  interviewDate   DateTime
  roundName       String       // Technical Round 1, System Design, HR Round
  status          String       @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  feedback        String?
  rating          Int?         // 1 to 5
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("interviews")
}

model JobOffer {
  id            String       @id @default(uuid())
  applicant     JobApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId   String       @unique
  offeredSalary Float
  joiningDate   DateTime
  status        String       @default("SENT") // DRAFT, SENT, ACCEPTED, DECLINED
  offerLetter   String?      // Generated PDF path
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("job_offers")
}

model KRA {
  id           String    @id @default(uuid())
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  title        String
  description  String?
  weightage    Float     @default(0) // Percentage out of 100, e.g. 25.0
  target       String?
  status       String    @default("PENDING") // PENDING, APPROVED, IN_PROGRESS, ACHIEVED, MISSED
  year         Int       @default(2026)
  quarter      Int?      // 1, 2, 3, 4
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("kras")
}

model PerformanceAppraisal {
  id              String    @id @default(uuid())
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId      String
  appraisalCycle  String    // e.g., "FY26 Mid-Year Appraisal", "Q1 2026"
  startDate       DateTime
  endDate         DateTime
  selfRating      Float?    // 1.0 to 5.0
  selfFeedback    String?
  managerRating   Float?    // 1.0 to 5.0
  managerFeedback String?
  finalRating     Float?    // 1.0 to 5.0
  status          String    @default("DRAFT") // DRAFT, SUBMITTED_SELF, SUBMITTED_MANAGER, COMPLETED
  approvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("performance_appraisals")
}

model Feedback360 {
  id           String    @id @default(uuid())
  employee     Employee  @relation("RecipientRelation", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  reviewer     Employee  @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId   String
  feedback     String
  rating       Int?      // 1 to 5
  relationship String    @default("PEER") // PEER, MANAGER, SUBORDINATE
  anonymous    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("feedback_360")
}

model ExpenseClaim {
  id              String    @id @default(uuid())
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId      String
  title           String
  claimDate       DateTime  @default(now())
  category        String    // TRAVEL, MEALS, ACCOMMODATION, EQUIPMENT, OTHER
  amount          Float
  currency        String    @default("INR")
  receiptUrl      String?
  description     String?
  status          String    @default("PENDING") // PENDING, APPROVED_BY_MANAGER, APPROVED_BY_FINANCE, REJECTED, PAID
  managerId       String?
  managerRemarks  String?
  financeRemarks  String?
  payrollRecordId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("expense_claims")
}

model TravelAdvance {
  id              String    @id @default(uuid())
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId      String
  purpose         String
  amountRequested Float
  amountApproved  Float?
  claimDate       DateTime  @default(now())
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID, SETTLED
  advanceRemarks  String?
  settledAmount   Float?
  settledDate     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("travel_advances")
}

model ShiftType {
  id                  String            @id @default(uuid())
  name                String
  code                String?
  startTime           String            // e.g. "09:00"
  endTime             String            // e.g. "18:00"
  startDay            String?           @default("Monday")
  endDay              String?           @default("Monday")
  gracePeriod         Int?              @default(15)
  minimumWorkHours    Float?            @default(8.0)
  isActive            Boolean           @default(true)
  weeklyOffs          String?           @default("Sunday")
  shiftAllowance      Float             @default(0)
  ipRestricted        Boolean           @default(false)
  allowedIpRange      String?
  geoRestricted       Boolean           @default(false)
  allowedLatitude     Float?
  allowedLongitude    Float?
  allowedRadiusMeters Float?            @default(150)
  unpaidBreakMinutes  Int               @default(60)
  paidBreakMinutes    Int               @default(0)
  autoBreakRules      String?
  assignments         ShiftAssignment[] @relation("NewShift")
  prevAssignments     ShiftAssignment[] @relation("PrevShift")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("shift_types")
}

model ShiftAssignment {
  id                  String     @id @default(uuid())
  employee            Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId          String
  shiftType           ShiftType  @relation("NewShift", fields: [shiftTypeId], references: [id], onDelete: Cascade)
  shiftTypeId         String
  previousShiftType   ShiftType? @relation("PrevShift", fields: [previousShiftTypeId], references: [id], onDelete: SetNull)
  previousShiftTypeId String?
  startDate           DateTime
  endDate             DateTime?
  changeReason        String?
  changedBy           String?
  womenSafetyConfirmed Boolean   @default(false)
  transportAssigned    Boolean   @default(false)
  escortVendor         String?
  approvalReference    String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("shift_assignments")
}

model AttendanceRegularization {
  id                  String      @id @default(uuid())
  employee            Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId          String
  date                DateTime
  requestType         String      // MISSING_PUNCH_IN, MISSING_PUNCH_OUT, INCORRECT_STATUS, LATE_JUSTIFICATION, EARLY_JUSTIFICATION, SHIFT_MISMATCH
  checkInCorrection   DateTime?
  checkOutCorrection  DateTime?
  statusCorrection    String?
  reason              String
  status              String      @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy          String?
  managerRemarks      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("attendance_regularizations")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  action      String   // e.g. SHIFT_CREATE, SHIFT_UPDATE, SHIFT_ASSIGN, REGULARIZATION_ACTION
  entity      String
  entityId    String?
  oldDetails  String?
  newDetails  String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model ChecklistTemplate {
  id          String                  @id @default(uuid())
  name        String                  // e.g. "Standard Developer Onboarding"
  type        String                  // "ONBOARDING" or "OFFBOARDING"
  description String?
  tasks       ChecklistTemplateTask[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@map("checklist_templates")
}

model ChecklistTemplateTask {
  id          String            @id @default(uuid())
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  title       String
  description String?
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("checklist_template_tasks")
}

model EmployeeChecklistTask {
  id          String    @id @default(uuid())
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  type        String    // "ONBOARDING" or "OFFBOARDING"
  title       String
  description String?
  status      String    @default("PENDING") // "PENDING", "IN_PROGRESS", "COMPLETED", "SKIPPED"
  dueDate     DateTime?
  completedAt DateTime?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("employee_checklist_tasks")
}

model PreviousEmployerIncome {
  id                    String   @id @default(uuid())
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId            String
  financialYear         String   // e.g. "2025-26"
  previousEmployerGross Float    @default(0)
  previousEmployerTDS   Float    @default(0)
  previousEmployerPF    Float    @default(0)
  previousEmployerPT    Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([employeeId, financialYear])
  @@map("previous_employer_income")
}

model EmployeeTaxDeclaration {
  id             String   @id @default(uuid())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String
  financialYear  String   // e.g. "2025-26"
  regime         String   @default("NEW") // "NEW" or "OLD"
  section80C     Float    @default(0)
  section80D     Float    @default(0)
  section24b     Float    @default(0)
  otherDeductions Float   @default(0)
  isFinalized    Boolean  @default(false)
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, financialYear])
  @@map("employee_tax_declarations")
}

model TDSLedger {
  id              String   @id @default(uuid())
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId      String
  payrollRecordId String?
  month           Int
  year            Int
  taxableIncome   Float
  tdsDeducted     Float
  calculatedAt    DateTime @default(now())

  @@unique([employeeId, month, year])
  @@map("tds_ledger")
}

model PayrollApproval {
  id           String     @id @default(uuid())
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollRunId String
  action       String
  actorId      String
  actorEmail   String
  comments     String?
  createdAt    DateTime   @default(now())

  @@map("payroll_approvals")
}

model PayrollAuditLog {
  id          String   @id @default(uuid())
  userEmail   String
  action      String
  entity      String
  entityId    String?
  oldDetails  String?
  newDetails  String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("payroll_audit_logs")
}

model ComplianceReport {
  id            String   @id @default(uuid())
  type          String
  status        String
  url           String?
  month         Int?
  year          Int?
  financialYear String?
  generatedBy   String
  createdAt     DateTime @default(now())

  @@map("compliance_reports")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id])
  legalEntityId String?
  code      String?
  state     String?
  timezone  String   @default("Asia/Kolkata")
  employees Employee[]
  locations Location[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@map("branches")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  branchId  String?
  state     String?
  city      String?
  address   String?
  pincode   String?
  timezone  String   @default("Asia/Kolkata")
  employees Employee[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@map("locations")
}

model Company {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  email          String?
  phone          String?
  address        String?
  industry       String?
  companySize    String?
  status         String          @default("ACTIVE")
  subscriptionId String?
  
  // Customization fields
  logoUrl        String?
  customInfo     String?

  // KYC Verification fields
  cin            String?
  gstin          String?
  directorName   String?
  directorPan    String?
  directorDin    String?
  signingAuthorityName  String?
  signingAuthorityEmail String?
  signingAuthorityPhone String?
  contactPersonName     String?
  contactPersonEmail    String?
  contactPersonPhone    String?
  kycStatus      String          @default("PENDING") // PENDING, APPROVED, REJECTED
  kycRemarks     String?
  demoCallScheduledAt DateTime?

  // Free Trial Management
  hasUsedFreeTrial Boolean       @default(false)
  freeTrialExpiresAt DateTime?

  users          User[]
  departments    Department[]
  legalEntities  LegalEntity[]
  branches       Branch[]
  locations      Location[]
  employees      Employee[]
  policies       PolicyDefinition[]
  workflows      WorkflowDefinition[]
  integrations   IntegrationConnection[]
  compliance     ComplianceObligation[]
  subscriptions  Subscription[]
  payments       PaymentTransaction[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("companies")
}

model LegalEntity {
  id                   String                 @id @default(uuid())
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId            String
  name                 String
  code                 String
  legalName            String?
  pan                  String?
  tan                  String?
  gstin                String?
  cin                  String?
  pfEstablishmentCode  String?
  esiEmployerCode      String?
  ptRegistrationNumber String?
  lwfRegistrationNumber String?
  registeredAddress    String?
  state                String?
  city                 String?
  pincode              String?
  status               String                 @default("ACTIVE")
  employees            Employee[]
  branches             Branch[]
  payrollRuns          PayrollRun[]
  compliance           ComplianceObligation[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([companyId, code])
  @@map("legal_entities")
}

model PolicyDefinition {
  id             String    @id @default(uuid())
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String?
  scopeType      String    @default("COMPANY")
  scopeId        String?
  policyType     String
  name           String
  description    String?
  version        Int       @default(1)
  status         String    @default("DRAFT")
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  rulesJson      String    @default("{}")
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([policyType, status])
  @@map("policy_definitions")
}

model WorkflowDefinition {
  id             String             @id @default(uuid())
  company        Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String?
  module         String
  name           String
  description    String?
  triggerEvent   String
  scopeType      String             @default("COMPANY")
  scopeId        String?
  status         String             @default("ACTIVE")
  stepsJson      String             @default("[]")
  createdBy      String?
  instances      WorkflowInstance[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([module, triggerEvent, status])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id             String              @id @default(uuid())
  definition     WorkflowDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  definitionId   String?
  module         String
  entityType     String
  entityId       String
  title          String
  requesterId    String?
  requesterEmail String?
  status         String              @default("PENDING")
  currentStep    Int                 @default(1)
  contextJson    String              @default("{}")
  tasks          WorkflowTask[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([module, entityType, entityId, status])
  @@map("workflow_instances")
}

model WorkflowTask {
  id              String            @id @default(uuid())
  instance        WorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId      String
  stepNumber      Int
  title           String
  assignedRole    String?
  assignedUserId  String?
  assignedEmail   String?
  status          String            @default("PENDING")
  action          String?
  comments        String?
  dueAt           DateTime?
  actedAt         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([assignedRole, assignedUserId, status])
  @@map("workflow_tasks")
}

model IntegrationConnection {
  id              String    @id @default(uuid())
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String?
  provider        String
  category        String
  displayName     String
  status          String    @default("DRAFT")
  configJson      String    @default("{}")
  secretsRef      String?
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastSyncMessage String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category, provider, status])
  @@map("integration_connections")
}

model ComplianceObligation {
  id             String       @id @default(uuid())
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String?
  legalEntity    LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  legalEntityId  String?
  obligationType String
  name           String
  periodMonth    Int?
  periodYear     Int?
  financialYear  String?
  dueDate        DateTime
  ownerRole      String?
  ownerUserId    String?
  status         String       @default("OPEN")
  riskLevel      String       @default("MEDIUM")
  evidenceUrl    String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([obligationType, dueDate, status])
  @@map("compliance_obligations")
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  location  String?
  type      String   @default("NATIONAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("holidays")
}

model BiometricDevice {
  id             String    @id @default(uuid())
  name           String
  deviceIp       String?
  lastSyncTime   DateTime?
  lastClockDrift Int       @default(0)
  ntpValidated   Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("biometric_devices")
}

model Asset {
  id             String    @id @default(uuid())
  assetTag       String    @unique
  name           String
  category       String
  serialNumber   String?
  condition      String    @default("GOOD")
  status         String    @default("AVAILABLE")
  assignedTo     Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedAt     DateTime?
  returnedAt     DateTime?
  recoveryStatus String    @default("NOT_APPLICABLE")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("assets")
}

model LearningCourse {
  id          String               @id @default(uuid())
  title       String
  description String?
  category    String               @default("GENERAL")
  isMandatory Boolean              @default(false)
  isActive    Boolean              @default(true)
  enrollments LearningEnrollment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("learning_courses")
}

model LearningEnrollment {
  id          String         @id @default(uuid())
  course      LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  status      String         @default("ASSIGNED")
  progress    Int            @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([courseId, employeeId])
  @@map("learning_enrollments")
}

model HelpdeskTicket {
  id          String    @id @default(uuid())
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  category    String    @default("HR")
  subject     String
  description String
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  assignedTo  String?
  resolution  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("helpdesk_tickets")
}

model Notification {
  id         String    @id @default(uuid())
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String?
  title      String
  message    String
  type       String    @default("INFO")
  isRead     Boolean   @default(false)
  actionUrl  String?
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@map("notifications")
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Float
  billingCycle  String         @default("MONTHLY") // MONTHLY, YEARLY
  employeeLimit Int            @default(50)
  featureLimits String         @default("{}") // Store as JSON string
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("plans")
}

model Subscription {
  id                     String               @id @default(uuid())
  companyId              String
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan                 @relation(fields: [planId], references: [id])
  status                 String               @default("INACTIVE") // ACTIVE, INACTIVE, EXPIRED, CANCELLED
  startDate              DateTime             @default(now())
  endDate                DateTime
  renewalDate            DateTime?
  paymentProvider        String?              // RAZORPAY, STRIPE, MOCK
  providerSubscriptionId String?
  payments               PaymentTransaction[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@map("subscriptions")
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount            Float
  currency          String        @default("INR")
  status            String        @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentProvider   String        @default("MOCK") // RAZORPAY, STRIPE, MOCK
  providerPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("payment_transactions")
}

model ContactRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  companyName String?
  message     String
  status      String   @default("PENDING") // PENDING, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contact_requests")
}
